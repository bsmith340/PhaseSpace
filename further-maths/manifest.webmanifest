{
  "id": "./",
  "name": "BCS Academy",
  "short_name": "BCS Academy",
  "description": "Free self-study guides for CCEA A level Mathematics, Further Mathematics and Physics: textbook notes, worked examples, simulations, practice papers and progress tracking. Independent: not affiliated with or endorsed by CCEA.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#f5f5f7",
  "background_color": "#f5f5f7",
  "categories": ["education"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Physics", "url": "./#/physics", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Calculator", "url": "./#/calc", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Settings", "url": "./#/settings", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
